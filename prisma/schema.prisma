/// 网关安全中心策略（admin 热配置单行表；client 网关/任务层经 lib/gateway/policy 读取器消费，
/// 进程内 TTL 微缓存，DB 不可用时降级默认值 fail-open）
model GatewayPolicyConfig {
  id                  String   @id @default("singleton")
  /// 紧急只读熔断：暂停后台重任务认领与新重任务提交，保住主站阅读与 MCP 读工具
  emergencyReadOnly   Boolean  @default(false)
  /// Web 匿名公共接口全局 RPM（按 IP 滑动窗口，proxy.ts 执行）
  webApiRpm           Int      @default(120)
  /// 恶意扫描器 UA 拦截开关
  scannerBlockEnabled Boolean  @default(true)
  /// 空 User-Agent 拦截开关（默认关；心跳/容器互调路径永久豁免）
  blockEmptyUserAgent Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

/// 网关 IP 黑名单（proxy.ts 全站 API 生效；admin 控制台维护，TTL 缓存同步）
model GatewayBlockedIp {
  ipAddress String   @id
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())
}

/// 网关安全事件流水（扫描器 403 / IP 封禁命中 / Web 全局 429 / 空 UA 拦截），
/// admin「网关拦截流水」的真实数据源；保留期由 retention.gatewayEventDays 清理
model GatewaySecurityEvent {
  id        String   @id @default(cuid())
  kind      String
  ipAddress String?
  path      String
  userAgent String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}

model DissectionCache {
