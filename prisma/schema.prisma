  updatedAt   DateTime @updatedAt

  @@index([codeHash])
}

model PlatformPromotion {
  id           String    @id @default(cuid())
  title        String
  subtitle     String?
  targetUrl    String?
  badge        String    @default("🔥 热门推荐")
  isPinned     Boolean   @default(true)
  displayOrder Int       @default(0)
  // 公告扩展（kind=promotion 推荐位 / announcement 全站横幅公告）
  kind         String    @default("promotion") // promotion / announcement
  startsAt     DateTime?
  endsAt       DateTime?
  dismissible  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPinned, displayOrder])
  @@index([kind, startsAt, endsAt])
}

model GlobalMcpToolPolicy {
  id                String   @id @default(cuid())
  toolName          String   @unique
  isEnabled         Boolean  @default(true)
  tokenBudget       Int      @default(4000)
  customDescription String?  @db.Text
  tierRequirement   String   @default("FREE")
  updatedAt         DateTime @updatedAt
}

/// 标签词表种类：category=单选分类（严格封闭，LLM 只能从中选）；tag=多值标签（受控扩展）
enum TagKind {
  CATEGORY
  TAG
}

/// 全站标签/分类注册表：管理端维护基础词表，AI 探测从中选择；词表外的新值
/// 在导入入库时受控登记（source=ai），管理端可编辑/停用，防止标签无限膨胀
model TagRegistry {
  id        String   @id @default(cuid())
  /// 规范值（唯一允许写入 Repository.category / Repository.tags 的形态）
  value     String   @unique
  kind      TagKind  @default(TAG)
  /// 同义别名（AI 输出或存量数据中出现过的形式，写入时归一到 value）
  aliases   String[] @default([])
  /// 来源：seed（初始词表）| ai（LLM 探测新建）| admin（管理员手工）| legacy（存量归一）
  source    String   @default("seed")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
}

model McpOpenDoc {
  id          String    @id @default(cuid())
  version     Int       @default(1)
  status      String    @default("DRAFT") // DRAFT | PENDING_REVIEW | PUBLISHED | ARCHIVED
  title       String    @default("OpenGits MCP 网关开放文档")
  markdown    String    @db.Text
  changelog   String?
  authorEmail String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, version])
}

model TutorialConceptNode {
  id                String   @id @default(cuid())
  repositoryId      String
  documentId        String?
  // 溯源锚点：概念 ↔ 原文 Chunk（chunkId + headingPath 由入库时反查 DocumentChunk 回填，best-effort）
  chunkId           String?
  headingPath       String?
  conceptName       String
  slug              String
  // 仓内归并层（L1）：canonicalKey = normalizeHeadingKey(conceptName)，同仓同 key 的节点
  // 视为同一概念组（共享邻居/依赖/目录名额）；canonicalName = 组内代表性显示名（频次最高，
  // 同频取更短者、再取字典序最小，确定性可重放）。均为 nullable：未回填的存量节点按未归并处理。
  canonicalKey      String?
  canonicalName     String?
  category          String   @default("architecture") // architecture | workflow | principle | reflection
  principlesText    String?  @db.Text
  authorReflections String?  @db.Text
  sopSteps          String[] @default([])
  summary           String?  @db.Text
  subTopics         String[] @default([])
  tags              String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository    Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  // 删文档时级联删除其概念节点：避免孤儿概念（documentId 被置 null 却仍参与共现/邻居查询）污染全仓拓扑。
  // 关联边 sourceNode/targetNode 为 Cascade（自动清理）。
  document      Document?      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // 跨仓对齐：同义概念归并到唯一 GlobalConcept（FTS + 名称归一化，无 embedding）。nullable=未对齐。
  globalConcept GlobalConcept? @relation(fields: [globalConceptId], references: [id], onDelete: SetNull)

  // 概念图边（TutorialConceptEdge）两侧引用
  outgoingEdges TutorialConceptEdge[] @relation("edgeSource")
  incomingEdges TutorialConceptEdge[] @relation("edgeTarget")

  // 跨仓对齐 FK（见 globalConcept 关系）
  globalConceptId String?

  @@unique([repositoryId, slug])
  @@index([repositoryId, category])
  @@index([conceptName])
  @@index([repositoryId, canonicalKey])
  @@index([chunkId])
  @@index([globalConceptId])
}

/**
 * 全局概念（跨仓对齐层，设计规范 §3.3）。
 * 把多仓里同义的概念节点（如各仓的"事件循环"）归并到一个 canonical GlobalConcept，
 * 供 concept_search 跨仓归并、recommend_tutorial/skill_coverage 跨仓精确匹配。
 * 对齐方式：normalizeHeadingKey 归一化 + FTS 召回（明确不做 embedding）。aliases 累积变体名。
 */
model GlobalConcept {
  id            String   @id @default(cuid())
  canonicalName String   @unique
  aliases       String[] @default([])
  description   String?  @db.Text

  concepts TutorialConceptNode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([canonicalName])
}

/**
 * 教程知识图谱边
 * 把 TutorialConceptNode 从「概念目录」升级为「真图」的关系载体。
 * type 语义：
 * prerequisite - 前置依赖：理解 target 需先掌握 source
 * related      - 语义相关：同一主题域内相邻概念（当前主要由文档/Chunk 共现产生）
 * part_of      - 组成关系：source 是 target 的组成部分
 * successor    - 递进关系：教程推荐学习顺序中 source 先于 target
 * source 证据来源（确定性优先）：
 * cooccurrence     - 文档/Chunk 共现（确定性，当前已落地）
 * curriculum_order - 教程大纲教学顺序（确定性，基于 navTree 顺序）
 * code_dep         - 符号依赖图（确定性，待真实 AST 解析接入，见设计文档）
 * llm_extracted    - LLM 提炼（带幻觉风险，后续阶段）
 */
model TutorialConceptEdge {
  id           String @id @default(cuid())
  repositoryId String
  sourceId     String
  targetId     String
  type         String @default("related")
  weight       Float  @default(1.0) // 证据强度 0~1
  source       String @default("cooccurrence")
  meta         Json? // 证据明细：chunkId / documentId / 提取理由

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceNode TutorialConceptNode @relation("edgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetNode TutorialConceptNode @relation("edgeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  repository Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([repositoryId, type])
  @@index([targetId])
}

// ─────────────────────────────────────────────────────────────
// 章节随堂测验（结构化）：转录 manifest 的 quizzes 原样落库。
// 与概念 reflections 折叠文本并存（Web 语义不变，能力不倒退）；
// MCP explore_concept(action="quiz") 与回填脚本消费。
// ─────────────────────────────────────────────────────────────
model ChapterQuiz {
  id           String   @id @default(cuid())
  documentId   String
  repositoryId String
  question     String
  options      String[]
  correctIndex Int
  explanation  String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([documentId, order])
  @@index([repositoryId])
}

model SystemPrompt {
  id         String          @id @default(cuid())
  key        String          @unique
  name       String
  module     String
  currentVer Int             @default(1)
  versions   PromptVersion[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model PromptVersion {
  id           String       @id @default(cuid())
  promptId     String
  version      Int
  promptSchema Json
  modelConfig  Json?
  isDefault    Boolean      @default(false)
  prompt       SystemPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@index([promptId, version])
}

model McpActiveSession {
  id         String   @id @default(cuid())
  userId     String
  clientName String
  clientVer  String?
  ipAddress  String?
  lastSeenAt DateTime @default(now())
  status     String   @default("ACTIVE")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientName])
  @@index([userId, lastSeenAt])
}

// ─────────────────────────────────────────────────────────────
// MCP 接入层：API Token（供 Cursor/Claude Code/Codex 等无浏览器
// Cookie 的智能体客户端经 Authorization: Bearer 调用）
// ─────────────────────────────────────────────────────────────
model McpApiToken {
  id             String    @id @default(cuid())
  userId         String
  name           String // Token 用途名（如 "Cursor"、"Claude Code"）
  tokenHash      String    @unique // sha256(token)，用于鉴权校验
  encryptedToken String? // AES-256-GCM 加密密文，用于用户本人在向导中快速复制
  prefix         String // 明文前 8 位，用于列表展示识别
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// MCP 调用观测（隐私安全版）：仅工具名/仓库/状态/耗时/命中数，
// 不存查询词、不关联用户——取代已移除的 McpQueryLog（含原始查询词）。
// ─────────────────────────────────────────────────────────────
model McpCallLog {
  id               String   @id @default(cuid())
  toolName         String
  /// 调用者（token 解析所得；匿名/session 兜底或历史行为 null）——用户隔离查询的依据
  userId           String?
  /// 发起调用的 MCP 客户端名（归一化后，与 McpActiveSession.clientName 同口径）；历史行为 null
  clientName       String?
  repositoryId     String?
  bundleId         String?
  dimension        String?
  status           String   @default("SUCCESS") // SUCCESS / BLIND_SPOT / ERROR
  resultCount      Int      @default(0)
  responseTimeMs   Int      @default(0)
  /// 端点/入参显式请求的讲法或版本（回退观测：requested≠resolved 即发生静默回退）
  requestedEdition String?
  /// 实际服务的讲法 key（'' = 基础讲法；归因与回退率统计）
  resolvedEdition  String?
  /// 解析回退标记（请求的讲法/版本未命中回退基础行时 true；fail-loud 警告的同源信号）
  isFallback       Boolean  @default(false)
  createdAt        DateTime @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  bundle     McpBundle?  @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([repositoryId, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([userId, clientName, createdAt])
  @@index([bundleId])
  @@index([isFallback, createdAt])
}

// ─────────────────────────────────────────────────────────────
// MCP 用量账本（配额地基）：按用户按日计数。
// 与隐私安全版 McpCallLog（无用户关联）互补——本表仅存聚合计数，
// 不含查询词、工具名明细等敏感维度，可安全用于配额与用量展示。
// ─────────────────────────────────────────────────────────────
model McpUsageLedger {
  id        String   @id @default(cuid())
  userId    String
  day       String // YYYY-MM-DD（UTC）
  mcpCalls  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// ─────────────────────────────────────────────────────────────
// 教程编排层（REPO_INGEST_REDESIGN §10）
// 编排层与内容层解耦：TutorialOutline/Part/Chapter/Node 是"结构/位置"，
// Document/DocumentChunk 是"实际文本内容"。重新编排只删/建编排层，内容层零改动。
// ─────────────────────────────────────────────────────────────

/// 一套教程编排大纲（支持多版本 + 激活切换 = 编排可逆）
model TutorialOutline {
  id           String     @id @default(cuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  mode         String     @default("tutorial") // 'tutorial' | 'explorer'
  version      Int        @default(1)
  isActive     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  parts    OutlinePart[]
  chapters OutlineChapter[]

  @@unique([repositoryId, version])
  @@index([repositoryId, isActive])
}

/// 大类（可选：章数 > 6 才聚合；≤ 6 时 chapters 直接挂 outline，partId 为 null）
model OutlinePart {
  id            String          @id @default(cuid())
  outlineId     String
  outline       TutorialOutline @relation(fields: [outlineId], references: [id], onDelete: Cascade)
  title         String
  summary       String?
  teachingOrder Int

  chapters OutlineChapter[]

  @@index([outlineId])
}

/// 章（教学单元）
model OutlineChapter {
  id            String          @id @default(cuid())
  outlineId     String
  outline       TutorialOutline @relation(fields: [outlineId], references: [id], onDelete: Cascade)
  partId        String?
  part          OutlinePart?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  title         String
  summary       String?
  chapterType   String          @default("mixed") // 'doc' | 'code' | 'mixed'
  moduleName    String? // 巨型仓子系统模块名归属（与 ModuleMapEntry.moduleName 直连，消除脆弱正则标题反查）
  teachingOrder Int

  nodes OutlineNode[]

  @@index([outlineId])
  @@index([partId])
}

/// 节（编排最细单元：不存内容，只是"指向哪个 Document 的哪个 heading"的编排指针）
model OutlineNode {
  id            String         @id @default(cuid())
  chapterId     String
  chapter       OutlineChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  documentId    String? // 关联内容层（Document）；编排时 Document 可能未建，可空
  document      Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  headingPath   String? // Document 内 heading 定位（节 < 文件时）
  title         String
  nodeType      String         @default("doc") // 'doc' | 'code'
  teachingOrder Int

  @@index([chapterId])
  @@index([documentId])
}

// ─────────────────────────────────────────────────────────────
// 巨型仓探索器模型（REPO_INGEST_REDESIGN §10.4）
// mode=explorer 专属：一个巨型仓一篇架构综述全文 + N 个顶级子系统模块地图卡片
// ─────────────────────────────────────────────────────────────

/// 巨型仓探索器架构综述（系统全景、Mermaid 交互拓扑图、核心类型与推荐路径）
/// 全局大模型服务商与端点配置（Admin 控制台动态配置，客户端实时拉取）
model GlobalModelProvider {
  id           String   @id @default(cuid())
  providerKey  String   @unique // 如 "google", "deepseek", "zhipu", "dashscope", "openai", "anthropic", "custom"
  name         String // 如 "Google Gemini", "DeepSeek", "智谱 GLM"
  label        String // 如 "Google Gemini (AI Studio)", "DeepSeek API"
  badgeLabel   String // 如 "🔴 Google Gemini", "🔵 DeepSeek"
  baseUrl      String // 如 "https://generativelanguage.googleapis.com/v1beta/openai"
  apiFormat    String   @default("openai") // "openai" | "anthropic"
  defaultModel String // 如 "gemini-3.7-flash"
  models       String[] @default([]) // 如 ["gemini-3.7-flash", "gemini-3.1-pro"]
  isEnabled    Boolean  @default(true)
  isDefault    Boolean  @default(false)
  displayOrder Int      @default(0)
  description  String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled, displayOrder])
}

/// 用户服务商聚合配置（同一个厂商统一在一个记录中管理多个模型与 API Key）
model UserModelProvider {
  id            String    @id @default(cuid())
  userId        String
  providerKey   String // 如 "dashscope", "google", "deepseek", "zhipu", "openai", "anthropic", "custom"
  name          String // 如 "阿里百炼", "Google Gemini", "DeepSeek API"
  baseUrl       String // 端点 URL
  apiKey        String // 该厂商的 API Key——AES-256-GCM 密文落库（enc:v1:...，lib/crypto/api-key-cipher）；
  // 写入路径 encryptApiKey（model-providers 路由），读取路径 tryDecryptApiKey（user-model-resolver）
  apiFormat     String    @default("openai") // "openai" | "anthropic"
  models        String[]  @default([]) // 该厂商下包含的所有模型列表
  selectedModel String // 该厂商当前选中的主模型 (如 "qwen3.6-flash")
  isActive      Boolean   @default(false) // 是否为当前全局激活使用的默认厂商 (全局唯一)
  healthStatus  String    @default("unknown") // "healthy" | "unhealthy" | "unknown"
  latencyMs     Int? // 最近测速耗时
  lastError     String? // 最近错误说明
  lastTestedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerKey])
  @@index([userId, isActive])
}

// ─────────────────────────────────────────────────────────────
// OAuth 2.1 协议层：动态客户端注册（RFC 7591 / MCP 规范）
// ─────────────────────────────────────────────────────────────
model OAuthClient {
  id           String   @id // client_id (opgts-client-xxx)
  name         String // client_name (例如 "Cursor", "Claude Code")
  redirectUris String[] // redirect_uris 白名单列表
  createdAt    DateTime @default(now())

  authCodes OAuthAuthCode[]
}

// ─────────────────────────────────────────────────────────────
// OAuth 2.1 协议层：授权码（一次性、5 分钟有效、落库防重启即丢）
// ─────────────────────────────────────────────────────────────
model OAuthAuthCode {
  code          String   @id // 授权码主键（一次性高熵随机串）
  clientId      String
  userId        String
  codeChallenge String // PKCE S256 challenge
  redirectUri   String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// 遗留表区已清（迁移 20261112000000_open_source_hardening）：早期商业化实验的
// PlatformCommercialConfig / RedeemCode / RedeemRecord / Subscription 四表
// 确认代码零引用后，按「先归档 → 删模型 → 显式迁移」流程物理删除。
// ─────────────────────────────────────────────────────────────

/// Go daemon 任务运行台账（每轮一条汇总行——宪章公理 5：禁止逐事件写放大）。
/// 写者唯一：Go runner.runOnce 单点埋表；Node 只读（admin 观测面）。
/// task-health-alert 任务按「连续 failed ≥ 3」窗口判定并推送 webhook。
model DaemonTaskRun {
  id         String   @id
  task       String
  status     String // ok | failed
  durationMs Int
  detail     String?
  createdAt  DateTime @default(now())

  @@index([task, createdAt])
}

/// RSG 语义图谱持久化索引（Single-Writer：仅 Go sidecar 写入与读取，
/// 彻底消除容器重启、跨卷部署或本地磁盘淘汰导致的 AST 符号索引空洞）。
model RepoSemanticGraph {
  id          String   @id @default(cuid())
  owner       String
  repo        String
  gitSha      String
  payload     Bytes
  symbolCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([owner, repo, gitSha])
  @@index([owner, repo])
}
