{
  "name": "opengits",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "npm run dev --prefix apps/client",
    "build": "npm run i18n:compile && npm run build --prefix apps/client",
    "build:client": "npm run build --prefix apps/client",
    "start": "npm run start --prefix apps/client",
    "start:client": "npm run start --prefix apps/client",
    "lint": "eslint",
    "lint:hardcode": "node scripts/lint-anti-hardcode.mjs",
    "lint:swallow": "node scripts/lint-swallow.mjs",
    "lint:schema-drift": "node scripts/lint-schema-drift.mjs",
    "lint:audit-matrix": "node scripts/audit-matrix.mjs --check",
    "lint:go": "node scripts/lint-go-invariants.mjs",
    "lint:test-budget": "node scripts/lint-test-budget.mjs",
    "gen:audit-matrix": "node scripts/audit-matrix.mjs --write",
    "i18n:compile": "npm run i18n:compile --prefix apps/client",
    "i18n:sync": "npx tsx apps/client/scripts/i18n-sync.ts",
    "seed:tags": "prisma db seed",
    "seed:prompts:push": "npx tsx prisma/seed.ts --push",
    "cache:purge": "npx tsx -e 'import(\"./apps/client/src/engine/repo-tarball\").then(m => m.purgeRepoCache())'",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:ddl-export": "node scripts/export-baseline-ddl.mjs",
    "sqlc:gen": "sqlc generate -f services/worker-sidecar/sqlc.yaml",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:golden": "node scripts/run-golden-diff.mjs",
    "test:golden:update": "node scripts/run-golden-diff.mjs --update",
    "test": "vitest run tests/unit && vitest run tests/integration",
    "loadtest:mcp": "node tests/load/mcp-loadtest.mjs",
    "verify": "npm run i18n:compile && node scripts/smart-verify.mjs && npm run check:prompts",
    "verify:fast": "npm run i18n:compile && npx tsc --noEmit --project apps/client/tsconfig.json && node scripts/lint-anti-hardcode.mjs && node scripts/lint-swallow.mjs",
    "check:prompts": "npx tsx -e 'import(\"./apps/client/src/lib/prompt-registry\").then(m => m.PromptRegistry.checkDriftCli())'",
    "dev:stop": "node scripts/dev.js stop",
    "dev:test": "node scripts/dev.js test",
    "dev:all": "node scripts/dev.js all"
  },
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "@ai-sdk/openai": "^4.0.71",
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@ai-sdk/react": "^4.0.15",
    "@base-ui/react": "^1.6.0",
    "@fumadocs/mdx-remote": "^1.4.10",
    "@modelcontextprotocol/server": "^2.3.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/typography": "^0.5.20",
    "ai": "^7.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "fs-extra": "^11.3.6",
    "fumadocs-core": "^16.10.7",
    "fumadocs-ui": "^16.10.7",
    "hast-util-sanitize": "^5.0.2",
    "langfuse": "^3.38.20",
    "lucide-react": "^1.23.0",
    "mermaid": "^11.16.0",
    "next": "16.3.6",
    "next-auth": "^4.24.14",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-unwrap-images": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "undici": "^8.12.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@sentry/nextjs": "^10.71.0",
    "@sentry/node": "^10.71.0",
    "@tailwindcss/postcss": "^4",
    "@types/fs-extra": "^11.0.4",
    "@types/mdast": "^4.0.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fast-check": "^4.10.2",
    "prisma": "^6.19.3",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "@ai-sdk/provider": "4.0.17"
  }
}
