# ===================================================
# OpenGits deployment environment variables
# ===================================================
# English-first comments; core setup needs only the two variables in the
# first section. Every optional variable degrades gracefully when left empty.

# ---------------------------------------------------
# Core required variables (deployment only needs these two)
# ---------------------------------------------------
DATABASE_URL=postgresql://opengits:opengits_local_dev@localhost:5433/opengits_db?schema=public
# Postgres credentials used by docker-compose (overridable via POSTGRES_PASSWORD).
# NOTE: the password only takes effect on FIRST volume initialization; changing it
# later requires ALTER USER inside the db container or resetting the data volume.
# POSTGRES_PASSWORD=opengits_local_dev
# Connection pool budget (required reading for multi-process deployments):
# Prisma defaults to num_cpus*2+1 connections per process; web+worker together
# can approach PG max_connections (default 100).
# Explicit sizing recommended, e.g.: ?schema=public&connection_limit=10&pool_timeout=10
# Alibaba Cloud Bailian (DashScope) API key: https://bailian.console.aliyun.com/
# LLM API key: NOT in env — users enter their own key (BYOK) in the app settings page,
# stored encrypted in DB (UserModelProvider). No env-based key consumption.

# ---------------------------------------------------
# Optional variables (leave empty = graceful degradation)
# ---------------------------------------------------

# ── Error monitoring (self-hosted GlitchTip, Sentry protocol compatible) ──
# Empty = local structured logging only (zero-cost fallback). When set, web/worker aggregate exception reports.
# Setup: docker compose up -d glitchtip → create org/project in the web UI → paste DSN here → restart both apps.
# GlitchTip container config itself (GLITCHTIP_SECRET_KEY / GLITCHTIP_DOMAIN / GLITCHTIP_EMAIL_URL):
# see the glitchtip service block in docker-compose.yml.
SENTRY_DSN=

# NextAuth signing secret (dev falls back to a default signer when empty; production MUST set it or boot fails fast)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth login (sign-in via GitHub OAuth App)
GITHUB_ID=
GITHUB_SECRET=

# Admin email allow-list (comma separated; matching emails are auto-granted SUPER_ADMIN)
ADMIN_EMAILS=

# Upstream change-check scheduler (detects only; users decide when to update):
# 1 = enabled (default interval 360 min; adjustable via UPSTREAM_CHECK_INTERVAL_MIN)
UPSTREAM_CHECK_ENABLED=0
UPSTREAM_CHECK_INTERVAL_MIN=360

# Chapter auto-refresh scheduler (carried by Go worker-sidecar; WORKER_GO_AUTO_UPDATE gate, on by default):
# interval via AUTO_UPDATE_INTERVAL_MIN (default 60 min). Per-repo opt-in via Repository.autoSyncEnabled=true.
# Tunables: see lib/config.ts updateMarket
AUTO_UPDATE_INTERVAL_MIN=60

# Langfuse LLM observability tracing (empty = tracing off)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=http://localhost:3100

# ---------------------------------------------------
# Google OAuth login (optional; wired automatically when set)
# Create an OAuth 2.0 Client ID in Google Cloud Console
# ---------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------
# Microsoft / Azure AD login (optional; wired automatically when set)
# Create an App Registration in Azure Portal / Entra ID
# ---------------------------------------------------
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# ---------------------------------------------------
# Concept-graph LLM edge inference (default off; enhancement feature, opt-in)
# ---------------------------------------------------
# When true, each transcribed chapter additionally asks the reader's BYOK model to
# infer prerequisite/related concept edges for the knowledge graph (extra LLM call
# per chapter, off the critical path). Deterministic co-occurrence/curriculum edges
# are always built regardless.
MCP_LLM_EDGES=false

# ---------------------------------------------------
# MCP control-plane sidecar (Go native binary, Phase 2a of the native-engine refactor)
# ---------------------------------------------------
# docker-compose injects MCP_UPSTREAM_URL (http://web:3000) and a small pgx pool;
# override here only for non-compose deployments. Sidecar knobs:
#   MCP_SIDECAR_ADDR (default :8081), MCP_SIDECAR_POOL_MAX (default 16),
#   MCP_PROXY_TIMEOUT_MS (default 120000)

# ---------------------------------------------------
# SSE Gateway sidecar (Go native binary, Milestone 2 of native-engine refactor)
# ---------------------------------------------------
# When set (e.g. http://worker-go:8082 in compose), persistent SSE connections are offloaded
# from the Next.js process to the Go native broadcast gateway. Empty = local Node implementation.
SSE_GATEWAY_URL=

# ---------------------------------------------------
# Server-side shared transcription queue (default ON)
# ---------------------------------------------------
# Go-native transform for transcription source fetch (M5 phase 1, default OFF)

# ---------------------------------------------------
# WebDoc import pipeline (LLM topology scout + Go sidecar Firecrawl/FastPath)
# ---------------------------------------------------
# WORKER_SIDECAR_URL: Go worker-sidecar HTTP endpoint executing web-doc import/sync jobs
#   and the /v1/web-doc/topology scout. docker-compose injects http://worker-go:8082;
#   set here only for non-compose local runs. Empty = http://127.0.0.1:8082.
# WORKER_GO_IMPORT_JOBS: must stay "1" — imports execute 100% in the Go Job Runner
#   (the Node in-process executor has been retired; "0" leaves ImportJob stuck QUEUED).
# FIRECRAWL_API_URL: self-hosted Firecrawl service used as the deep-render fallback
#   when the static fast-path misses (compose injects http://firecrawl-api:3002).
# WEB_CRAWLER_* knobs are read by the Go sidecar directly:
#   WEB_CRAWLER_FAST_PATH (default true), WEB_CRAWLER_RESPECT_ROBOTS (default true),
#   WEB_CRAWLER_POLITENESS_DELAY_MS (default 800), WEB_CRAWLER_MAX_PAGES (default 1000),
#   WEB_CRAWLER_USER_AGENT. TS also reads WEB_CRAWLER_MAX_PAGES as the wizard default cap.
# WEB_DOC_INGEST_RATE_MAX / _WINDOW_MIN: per-user submit throttling (default 5 req / 10 min).
# WEB_DOC_SYNC_RATE_MAX / _WINDOW_MIN: web-sync throttling (default 10 req / 10 min).
# WEB_DOC_SCOUT_RATE_MAX / _WINDOW_MIN: topology scout throttling (default 15 req / 5 min).
#WORKER_SIDECAR_URL=
#WORKER_GO_IMPORT_JOBS=1
#FIRECRAWL_API_URL=http://localhost:3002
#WEB_CRAWLER_MAX_PAGES=1000
#WEB_DOC_INGEST_RATE_MAX=5
#WEB_DOC_INGEST_RATE_WINDOW_MIN=10
