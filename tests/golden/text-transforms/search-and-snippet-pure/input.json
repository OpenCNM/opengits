  "snippetCases": [
    {
      "name": "internal-horizontal-rules-preserved",
      "text": "Section One Introduction\n---\nSection Two with target keyword authorization and permissions\n---\nSection Three Conclusion",
      "query": "authorization"
    },
    {
      "name": "frontmatter-stripped-no-query",
      "text": "---\ntitle: My Guide\nauthor: Team\ndate: 2026-01-01\n---\nWelcome to our system documentation. Here is information about authentication.",
      "query": ""
    },
    {
      "name": "frontmatter-stripped-with-query",
      "text": "---\ntitle: My Guide\nauthor: Team\ndate: 2026-01-01\n---\nWelcome to our system documentation. Here is information about authentication.",
      "query": "authentication"
    },
    {
      "name": "backtick-and-tilde-fences-stripped",
      "text": "\nIntroduction to the API.\n\n```typescript\nconst token = 'xyz'; // should not be in snippet\n```\n\n~~~bash\ncurl -H \"Auth: none\" https://api.example.com\n~~~\n\nFollow the deployment checklist for authentication setup.\n",
      "query": "deployment"
    },
    {
      "name": "centered-ellipses",
      "text": " keyword ",
      "repeatA": 50,
      "query": "keyword",
      "maxLen": 60
    },
    {
      "name": "snake-case-and-colons",
      "text": "Welcome. Call get_user_profile(user_id) to fetch the details. Note: tokens expire in 1 hour.",
      "query": "get_user_profile"
    }
  ],
