    { "name": "derive-from-markdown-path", "title": null, "path": "guide/intro.markdown", "content": null },
    { "name": "empty-fallback", "title": "", "path": "", "content": "" }
  ],
  "rerankCases": [
    {
      "name": "exact-phrase-in-heading-beats-content",
      "query": "server actions",
      "chunks": [
        { "similarity": 0.7, "heading": "", "title": "", "content": "contains server actions deep inside", "path": "docs/z-overview.md" },
        { "similarity": 0.6, "heading": "Server Actions", "title": "", "content": "", "path": "docs/a-target.md" }
      ]
    },
    {
      "name": "keyword-in-heading-beats-plain",
      "query": "useEffect 生命周期",
      "chunks": [
        { "similarity": 0.6, "heading": "", "title": "", "content": "", "path": "docs/x.md" },
        { "similarity": 0.55, "heading": "useEffect 生命周期", "title": "", "content": "", "path": "docs/y.md" }
      ]
    },
    {
      "name": "tiebreak-path-lexicographic",
      "query": "随便",
      "chunks": [
        { "similarity": 0.5, "heading": "", "title": "", "content": "", "path": "docs/b.md" },
        { "similarity": 0.5, "heading": "", "title": "", "content": "", "path": "docs/a.md" },
        { "similarity": 0.5, "heading": "", "title": "", "content": "", "path": "docs/c.md" }
      ]
    },
    {
      "name": "blank-query-passthrough",
      "query": "   ",
      "chunks": [
        { "similarity": 0.5, "heading": "", "title": "", "content": "", "path": "b.md" },
        { "similarity": 0.5, "heading": "", "title": "", "content": "", "path": "a.md" }
      ]
    },
    {
      "name": "snippet-fallback-when-content-empty",
      "query": "server actions",
      "chunks": [
        { "similarity": 0.5, "heading": "", "title": "", "content": "", "snippet": "contains server actions snippet", "path": "docs/z.md" },
        { "similarity": 0.5, "heading": "", "title": "", "content": "", "snippet": "no match snippet", "path": "docs/a.md" }
      ]
    }
  ],
  "locatorSnippetCases": [
    { "name": "longest-hit-centered", "content": "abcdefg", "repeatPad": 400, "keywords": ["zzz", "abcdefg"] },
    { "name": "no-hit-from-start", "content": "plain start text", "keywords": ["nomatch"] },
    { "name": "whitespace-collapsed", "content": "a\n\n  b\tc keyword", "keywords": ["keyword"] },
    { "name": "empty-content", "content": "", "keywords": ["x"] }
  ]
