      "name": "ignore-python-fence-comment",
      "title": "",
      "path": null,
      "content": "\n```python\n# This is a python comment, not a title\nimport os\nimport sys\n```\n\n# Actual Document Title\n\nThis is the document body.\n"
    },
    {
      "name": "ignore-tilde-bash-comment",
      "title": null,
      "path": null,
      "content": "\n~~~bash\n# Shell comment here\nexport NODE_ENV=production\n~~~\n\n# Production Deployment Guide\n"
    },
    {
      "name": "ignore-yaml-comment",
      "title": "",
      "path": null,
      "content": "---\ntitle: \"\"\ndescription: \"Frontmatter with comments\"\n# This is a YAML comment, NOT a doc title\nauthor: developer\n---\n\n# Real Section Title\n\nDoc contents.\n"
    },
    { "name": "derive-from-mdx-path", "title": "", "path": "docs/user-account-settings.mdx", "content": "" },
